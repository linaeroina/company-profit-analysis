   "source": [
    "from matplotlib.ticker import PercentFormatter\n",
    "years_available = sorted(df_clean['year'].unique())\n",
    "N = min(3, len(years_available)-1)  # Сравниваем с 3 годами назад (или меньше, если данных недостаточно)\n",
    "\n",
    "print(f\"Анализ роста прибыли за последние {N} года\")\n",
    "\n",
    "results = []\n",
    "for inn, group in df_clean.groupby('inn'):\n",
    "    group = group.sort_values('year')\n",
    "    latest = group.iloc[-1]\n",
    "    \n",
    "    # Преобразуем год в число\n",
    "    try:\n",
    "        latest_year = int(latest['year'])\n",
    "        target_year = latest_year - N  # Теперь вычитание сработает\n",
    "        \n",
    "        # Ищем год, который на N лет старше последнего\n",
    "        oldest_match = group[group['year'].astype(int) <= target_year]\n",
    "        \n",
    "        if not oldest_match.empty:\n",
    "            oldest = oldest_match.iloc[-1]\n",
    "            oldest_year = int(oldest['year'])\n",
    "            actual_period = latest_year - oldest_year\n",
    "            \n",
    "            if actual_period >= N and oldest['net_profit'] != 0:\n",
    "                growth_pct = (latest['net_profit'] - oldest['net_profit']) / abs(oldest['net_profit']) * 100\n",
    "                results.append({\n",
    "                    'inn': inn,\n",
    "                    'growth_pct': growth_pct,\n",
    "                    'period': actual_period,\n",
    "                    'latest_year': latest_year,\n",
    "                    'oldest_year': oldest_year\n",
    "                })\n",
    "    except (ValueError, TypeError) as e:\n",
    "        print(f\"Ошибка обработки компании {inn}: {str(e)}\")\n",
    "        continue\n",
    "\n",
    "growth_df = pd.DataFrame(results)\n",
    "plt.figure(figsize=(12, 6))\n",
    "plt.style.use('seaborn-v0_8')\n",
    "max_growth = growth_df['growth_pct'].abs().max()\n",
    "bins = np.linspace(-max_growth, max_growth, 11) \n",
    "plt.hist(growth_df['growth_pct'], bins=bins, edgecolor='black', alpha=0.7)\n",
    "\n",
    "plt.title(f'Распределение роста чистой прибыли компаний за {N} года', pad=20)\n",
    "plt.xlabel('Процент роста чистой прибыли', labelpad=10)\n",
    "plt.ylabel('Количество компаний', labelpad=10)\n",
    "plt.gca().xaxis.set_major_formatter(PercentFormatter())\n",
    "plt.grid(axis='y', alpha=0.3)\n",
    "    \n",
    "median_growth = growth_df['growth_pct'].median()\n",
    "mean_growth = growth_df['growth_pct'].mean()\n",
    "plt.axvline(median_growth, color='red', linestyle='--', label=f'Медиана: {median_growth:.1f}%')\n",
    "plt.axvline(mean_growth, color='green', linestyle='--', label=f'Среднее: {mean_growth:.1f}%')\n",
    "plt.legend()\n",
    "    \n",
    "plt.tight_layout()\n",
    "plt.savefig('profit_growth_distribution.png', dpi=300)\n",
    "plt.show()\n",
    "\n",
    "print(\"\\nАнализ распределения роста прибыли:\")\n",
    "print(f\"- Всего компаний в анализе: {len(growth_df)}\")\n",
    "print(f\"- Период анализа: {N} года\")\n",
    "print(f\"- Средний рост: {mean_growth:.1f}%\")\n",
    "print(f\"- Медианный рост: {median_growth:.1f}%\")\n",
    "\n",
    "growing = (growth_df['growth_pct'] > 0).mean() * 100\n",
    "declining = (growth_df['growth_pct'] < 0).mean() * 100\n",
    "    \n",
    "print(f\"\\nДоли компаний:\")\n",
    "print(f\"- С ростом прибыли: {growing:.1f}%\")\n",
    "print(f\"- С падением прибыли: {declining:.1f}%\")\n",
    "print(f\"- Без изменений: {100-growing-declining:.1f}%\")\n",
    "    \n"
   ]
