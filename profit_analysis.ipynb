   "cell_type": "markdown",
   "id": "7e913f0a-5bc8-4321-8861-e99628811825",
   "metadata": {},
   "source": [
    "Этот фрагмент кода собирает ключевые финансовые показатели (выручку, прибыль, EBITDA) по ИНН компаний из открытого API Федеральной налоговой службы.\n",
    "\n",
    "Что делает скрипт:\n",
    "\n",
    "Загружает данные через API ФНС (bo.nalog.gov.ru)\n",
    "Обрабатывает показатели:\n",
    "Выручка (коды 2110, gainSum)\n",
    "Себестоимость (2120)\n",
    "Чистая прибыль (2400)\n",
    "EBITDA (рассчитывается автоматически)\n",
    "Сохраняет результат в JSON с сохранением структуры данных\n",
    "Особенности:\n",
    "\n",
    "Многопоточный сбор (до 20 запросов одновременно)\n",
    "Защита от блокировки (задержки между запросами)\n",
    "Фильтрация некорректных данных\n",
    "Автосохранение промежуточных результатов\n",
    "Входные данные: Список ИНН в all_companies.txt\n",
    "Выходные данные: company_data.json с финансовыми показателями"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "57a5a405-f5dc-49f4-aedf-074c0f6f92b8",
   "metadata": {
    "scrolled": true
   },
   "outputs": [],
   "source": [
    "import json\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import requests\n",
    "from concurrent.futures import ThreadPoolExecutor, as_completed\n",
    "from time import sleep\n",
    "\n",
    "# Конфигурация\n",
    "MAX_COMPANIES = 1000\n",
    "THREADS = 20\n",
    "REQUEST_DELAY = 0.05\n",
    "SAVE_EVERY = 200\n",
    "\n",
    "# Ключи для данных\n",
    "REVENUE_KEYS = [\"gainSum\", \"2110\", \"current2110\"]\n",
    "COST_KEYS = [\"2120\", \"current2120\"]\n",
    "NET_PROFIT_KEYS = [\"2400\", \"current2400\"]\n",
    "AMORT_KEYS = [\"2350\", \"current2350\"]\n",
    "\n",
    "def get_first_value(data, keys):\n",
    "    for key in keys:\n",
    "        if key in data and data[key] is not None:\n",
    "            return data[key]\n",
    "    return None\n",
    "\n",
    "def fetch_company_data(inn, session):\n",
    "    try:\n",
    "        # 1. Получаем ID организации\n",
    "        params = {\"inn\": inn, \"allFieldsMatch\": \"false\", \"size\": 1}\n",
    "        response = session.get(\n",
    "            \"https://bo.nalog.gov.ru/advanced-search/organizations\",\n",
    "            params=params,\n",
    "            timeout=5\n",
    "        )\n",
    "        if response.status_code != 200:\n",
    "            return []\n",
    "        \n",
    "        org_id = response.json().get(\"content\", [{}])[0].get(\"id\")\n",
    "        if not org_id:\n",
    "            return []\n",
    "\n",
    "        # 2. Получаем финансовые данные\n",
    "        response = session.get(\n",
    "            f\"https://bo.nalog.gov.ru/nbo/organizations/{org_id}/bfo/\",\n",
    "            timeout=5\n",
    "        )\n",
    "        if response.status_code != 200:\n",
    "            return []\n",
    "        \n",
    "        bfo_list = response.json() or []\n",
    "        results = []\n",
    "\n",
    "        for bfo in bfo_list:\n",
    "            # Исправленная строка: правильно закрываем скобки next()\n",
    "            finres = next(\n",
    "                (tc[\"correction\"][\"financialResult\"] \n",
    "                 for tc in bfo.get(\"typeCorrections\", []) \n",
    "                 if \"correction\" in tc and \"financialResult\" in tc[\"correction\"]),\n",
    "                None\n",
    "            )\n",
    "\n",
    "            data_source = finres if finres else bfo\n",
    "            revenue = get_first_value(data_source, REVENUE_KEYS)\n",
    "            cost = get_first_value(data_source, COST_KEYS)\n",
    "            net_profit = get_first_value(data_source, NET_PROFIT_KEYS)\n",
    "            amort = get_first_value(data_source, AMORT_KEYS)\n",
    "            \n",
    "            ebitda = (revenue - cost + amort) if all(v is not None for v in [revenue, cost]) else None\n",
    "\n",
    "            if any([revenue, net_profit, ebitda]):\n",
    "                results.append({\n",
    "                    \"inn\": inn,\n",
    "                    \"year\": bfo.get(\"period\"),\n",
    "                    \"revenue\": revenue,\n",
    "                    \"cost\": cost,\n",
    "                    \"net_profit\": net_profit,\n",
    "                    \"amortization\": amort,\n",
    "                    \"ebitda\": ebitda\n",
    "                })\n",
    "\n",
    "        return results\n",
    "\n",
    "    except Exception:\n",
    "        return []\n",
    "\n",
    "def main():\n",
    "    with open(\"all_companies.txt\") as f:\n",
    "        inns = [line.strip() for i, line in enumerate(f) if line.strip() and i < MAX_COMPANIES]\n",
    "\n",
    "    print(f\"🚀 Старт обработки {len(inns)} компаний (потоков: {THREADS})...\")\n",
    "\n",
    "    session = requests.Session()\n",
    "    session.headers.update({\n",
    "        \"User-Agent\": \"Mozilla/5.0\",\n",
    "        \"Accept\": \"application/json\"\n",
    "    })\n",
    "\n",
    "    all_results = []\n",
    "    processed = 0ь\n",
    "\n",
    "    with ThreadPoolExecutor(max_workers=THREADS) as executor:\n",
    "        futures = {executor.submit(fetch_company_data, inn, session): inn for inn in inns}\n",
    "        \n",
    "        for future in as_completed(futures):\n",
    "            processed += 1\n",
    "            all_results.extend(future.result())\n",
    "            \n",
    "            if processed % 100 == 0:\n",
    "                print(f\"Обработано: {processed}/{len(inns)} компаний\")\n",
    "                \n",
    "            if processed % SAVE_EVERY == 0:\n",
    "                with open(\"company_data_partial.json\", \"w\") as f:\n",
    "                    json.dump(all_results, f)\n",
    "            \n",
    "            sleep(REQUEST_DELAY)\n",
    "\n",
    "    with open(\"company_data.json\", \"w\") as f:\n",
    "        json.dump(all_results, f, indent=2)\n",
    "\n",
    "    print(f\"✅ Готово! Обработано {len(all_results)} записей\")\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()"
   ]
  },
